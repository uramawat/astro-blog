---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Timeline">
    <h1>Timeline</h1>
    <p style="margin-bottom: 2rem;">
        A brief snapshot of where I've been and things I've done
    </p>

    <div class="timeline">
        <div class="timeline-item career">
            <div class="timeline-date">Jul'25 - Present</div>
            <h3>Archer Aviation</h3>
            <p>
                <div class="timeline-role">
                    <p>
                        Working on the future of Urban Air Mobility. Solving
                        hard problems.
                    </p>
                </div>
            </p>
        </div>
        <div class="timeline-item personal">
            <div class="timeline-date">Jan '25</div>
            <h3>Became a Dad</h3>
            <p>The greatest role I've taken on.</p>
        </div>
        <div class="timeline-item career">
            <div class="timeline-date">Nov'19 - Jul'25</div>
            <h3>Apple Inc.</h3>

            <div class="timeline-role">
                <ul>
                    <li>
                        Bunch of cool things that I can't talk about <Icon
                            name="lucide:lock"
                            class="lucide-icon"
                        />
                    </li>
                    <li>Wore many different hats for Vision Pro Launch</li>
                    <li>
                        Shipped my first consumer product - Airpods Max,
                        followed by a lot of audio and mac products. But the
                        first launch was special
                    </li>
                </ul>
            </div>
        </div>
        <div class="timeline-item personal">
            <div class="timeline-date">Oct'23</div>
            <h3>Married my Best Friend</h3>
            <p>The best partnership of my life.</p>
        </div>
        <div class="timeline-item career">
            <div class="timeline-date">Mar'16 - Nov'19</div>
            <h3>Intel Corp.</h3>
            <div class="timeline-role">
                <ul>
                    <li>
                        Delivered Encryption at Scale for all of Intel's IP.
                    </li>
                    <li>
                        Fell in love with th outdoors. Thank you Grand Canyon :)
                    </li>
                </ul>
            </div>
        </div>
        <div class="timeline-item career">
            <div class="timeline-date">Nov'15 - Mar'16</div>
            <h3>Apttus (acquired by Conga)</h3>
            <p>Learned a lot about Salesforce in a very small time</p>
        </div>
        <div class="timeline-item personal">
            <div class="timeline-date">Jun '15</div>
            <h3>Grad School & Donuts</h3>
            <p>
                Finished Grad School and found religion with Stan's <Icon
                    name="lucide:donut"
                    class="lucide-icon"
                /> Shop!
            </p>
        </div>
        <div class="timeline-item career">
            <div class="timeline-date">Sep'13 - Jun'15</div>
            <h3>Santa Clara University</h3>
            <p>Master of Science in Computer Science & Engineering.</p>
        </div>
        <div class="timeline-item personal">
            <div class="timeline-date">May '13</div>
            <h3>Pizza & Friends</h3>
            <p>
                Made lifelong friends, fell in love with deep-dish <Icon
                    name="lucide:pizza"
                    class="lucide-icon"
                />!
            </p>
        </div>
        <div class="timeline-item career">
            <div class="timeline-date">Aug'09 - May'13</div>
            <h3>Illinois Institute of Technology</h3>
            <p>Bachelor of Science in Computer Science.</p>
        </div>
    </div>
</Layout>
