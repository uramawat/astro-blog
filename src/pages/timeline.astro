---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Timeline">
    <h1>Timeline</h1>
    <p style="margin-bottom: 2rem;">A brief history of my career in tech.</p>

    <div class="timeline">
        <div class="timeline-item">
            <div class="timeline-date">Jul'25 - Present</div>
            <h3>Archer Aviation</h3>
            <p>
                <div class="timeline-role">
                    <p class="role-title">Staff Product Manager</p>
                    <p>Focused on a few different areas at Archer</p>
                    <ul>
                        <li>
                            Data Platform for Flight Test Analysis and Insights
                        </li>
                        <li>
                            Product SW Strategy for Consumer and Enterprise SW
                        </li>
                        <li>
                            Product Intelligence features targeted towards Urban
                            Air Mobility
                        </li>
                    </ul>
                </div>
            </p>
        </div>
        <div class="timeline-item">
            <div class="timeline-date">Nov'19 - Jul'25</div>
            <h3>Apple Inc.</h3>

            <div class="timeline-role">
                <p class="role-title">Staff Product Manager</p>
                <ul>
                    <li>Future visionOS platforms</li>
                </ul>
            </div>

            <div class="timeline-role">
                <p class="role-title">Senior Product Manager</p>
                <ul>
                    <li>
                        Siri On-Device Architecture for Next Generation
                        Platforms leveraging on-device and cloud based language
                        models.
                    </li>
                    <li>
                        visionOS 1.0 launch - Software Updates, core platform,
                        system performance
                    </li>
                    <li>
                        Mac M1 transition - Mac Studio Launch, Magic Keyboard
                        with touchID
                    </li>
                </ul>
            </div>
        </div>
        <div class="timeline-item">
            <div class="timeline-date">Mar'16 - Nov'19</div>
            <h3>Intel Corp.</h3>
            <p>
                Product Manager for Intel Information Security working on
                Encryption and Classification Products
            </p>
        </div>
        <div class="timeline-item">
            <div class="timeline-date">Nov'15 - Mar'16</div>
            <h3>Apttus (acquired by Conga)</h3>
            <p>Salesforce Analyst</p>
        </div>
        <div class="timeline-item">
            <div class="timeline-date">Sep'13 - Jun'15</div>
            <h3>Santa Clara University</h3>
            <p>Master of Science in Computer Science & Engineering.</p>
        </div>
        <div class="timeline-item">
            <div class="timeline-date">Aug'09 - May'13</div>
            <h3>Illinois Institute of Technology</h3>
            <p>Bachelor of Science in Computer Science.</p>
        </div>
    </div>
</Layout>
