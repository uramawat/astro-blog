---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="About Udit Ramawat">
    <h1>About Me</h1>
    <div class="about-copy">
        <img
            src="/sketch_profile.png"
            alt="Sketch portrait of Udit Ramawat"
            class="about-profile-image"
            width="1254"
            height="1254"
        />
        <p>
            Howdy! I'm a dad, husband, tinkerer, hiker and a <Icon
                name="lucide:coffee"
                class="lucide-icon"
            /> aficionado.
        </p>
        <p>
            I love clean design, beautiful architecture, craftsmanship and
            constant learning. I like building things that feel useful, calm, and considered, whether that’s software, a workflow, or a better way to spend a weekend outside.
        </p>
        <p>
            Also a huge Formula 1 Fan. #ForzaFerrari
        </p>
    </div>

    <div class="contact-section">
        <a href="mailto:udit.ramawat@gmail.com" class="contact-link">
            <Icon name="lucide:mail" />
            <span>Email Me</span>
        </a>
        <a
            href="https://linkedin.com/in/uditramawat"
            target="_blank"
            class="contact-link"
        >
            <Icon name="lucide:linkedin" />
            <span>LinkedIn</span>
        </a>
        <a
            href="https://github.com/uramawat"
            target="_blank"
            class="contact-link"
        >
            <Icon name="lucide:github" />
            <span>GitHub</span>
        </a>
        <a href="/resume.pdf" class="contact-link" download="Udit_Resume.pdf">
            <Icon name="lucide:file-text" />
            <span>Resume</span>
        </a>
    </div>
</Layout>
