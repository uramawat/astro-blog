# nginx configuration for the static site.
# The nginx entrypoint replaces ${PORT} with the PORT environment variable.
# nginx does not inherit add_header from the server block into a location
# that has its own add_header. Thus each location includes the security headers.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Send relative redirects. The public port and scheme can be different
    # from the container port when a proxy is in front of the container.
    absolute_redirect off;

    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types
        text/css
        text/plain
        text/xml
        application/javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml;

    error_page 404 /404.html;

    # HTML and other files without a content hash.
    # The browser must ask the server again before it uses a cached copy.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ $uri.html =404;
    }

    # Astro adds a content hash to each file name in /_astro/.
    # The content of a file never changes, so the browser can keep it for 1 year.
    location /_astro/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Download the resume. Do not open it in the browser.
    # vercel.json sets the same header on Vercel.
    location = /resume.pdf {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header Content-Disposition 'attachment; filename="Udit_Resume.pdf"' always;
    }
}
